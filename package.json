{
  "name": "shopify-storefront-api-client",
  "version": "1.3.0",
  "description": "Strongly typed TypeScript SDK for Shopify Storefront GraphQL API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "build": "rollup -c",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "gen:types": "npx type-crafter generate typescript-with-decoders ./types/index.yaml ./src/generated/types SingleFile SingleFile && pnpm run format && pnpm run lint:fix",
    "test": "tsx test/index.ts"
  },
  "keywords": [
    "shopify",
    "storefront",
    "graphql",
    "api",
    "typescript"
  ],
  "author": "Sahil Sinha",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sinha-sahil/shopify-storefront-api-client.git"
  },
  "bugs": {
    "url": "https://github.com/sinha-sahil/shopify-storefront-api-client/issues"
  },
  "homepage": "https://github.com/sinha-sahil/shopify-storefront-api-client#readme",
  "packageManager": "pnpm@10.5.2",
  "dependencies": {
    "type-decoder": "^2.2.0",
    "typesafe-api-call": "^5.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.1",
    "rollup": "^4.57.1",
    "rollup-plugin-dts": "^6.3.0",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "type-crafter": "^0.12.0"
  }
}
